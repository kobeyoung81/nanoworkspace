{
  "contract": 1,
  "plugin": "workspace",
  "entry": "/plugins/workspace/remoteEntry.js",
  "panels": [
    {
      "id": "git",
      "title": {
        "zh-CN": "Git",
        "en": "Git"
      },
      "icon": "git-branch",
      "slot": "right",
      "mount": {
        "kind": "module",
        "module": "workspace/panels",
        "export": "GitPanel"
      }
    }
  ],
  "pages": [
    {
      "id": "files",
      "path": "/files",
      "title": {
        "zh-CN": "文件",
        "en": "Files"
      },
      "mount": {
        "kind": "module",
        "module": "workspace/pages",
        "export": "FilesPage"
      }
    },
    {
      "id": "file-view",
      "path": "/files/view",
      "title": {
        "zh-CN": "文件预览",
        "en": "File preview"
      },
      "mount": {
        "kind": "module",
        "module": "workspace/pages",
        "export": "FileViewerPage"
      }
    },
    {
      "id": "agent",
      "path": "/agent",
      "title": {
        "zh-CN": "智能体",
        "en": "Agent"
      },
      "mount": {
        "kind": "module",
        "module": "workspace/pages",
        "export": "AgentPage"
      }
    }
  ],
  "provides": {
    "filePanel": {
      "module": "workspace/pages",
      "export": "FilePanel"
    }
  }
}
